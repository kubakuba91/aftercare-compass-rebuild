generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  system_admin
  referent_admin
  referent_manager
  aftercare_admin
  aftercare_manager
}

enum OrganizationType {
  referent
  aftercare_sober_living
  aftercare_continued_care
}

enum ProfileType {
  sober_living
  continued_care
}

enum ProfileStatus {
  draft
  published
  unpublished
  suspended
  under_review
}

enum ReferralStatus {
  pending
  viewed
  accepted
  declined
  waitlisted
  placed
  closed
}

enum LeadStatus {
  new
  contacted
  closed
  spam
}

enum SubscriptionStatus {
  incomplete
  trialing
  active
  past_due
  canceled
  unpaid
}

enum DocumentStatus {
  pending
  approved
  rejected
}

enum FlagStatus {
  open
  under_review
  resolved_action_taken
  resolved_no_action
}

enum AdminReviewSubjectType {
  referent_org
  aftercare_profile
}

enum AdminReviewStatus {
  pending
  approved
  rejected
}

enum ProfileOwnershipStatus {
  claimed
  unclaimed
  claim_pending
}

enum ProfileClaimStatus {
  pending
  approved
  rejected
  cancelled
}

enum AftercareManagerScope {
  all_profiles
  assigned_profiles
}

model ProfileOption {
  id        String   @id @default(cuid())
  category  String
  label     String
  isActive  Boolean  @default(true)
  showForSoberLiving   Boolean  @default(true)
  showForContinuedCare Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([category, label])
  @@index([category, isActive, sortOrder])
}

model User {
  id              String        @id @default(cuid())
  clerkUserId     String        @unique
  email           String        @unique
  phone           String?
  smsOptIn        Boolean       @default(false)
  aftercareManagerScope AftercareManagerScope @default(all_profiles)
  firstName       String?
  lastName        String?
  role            Role
  orgId           String?
  organization    Organization? @relation(fields: [orgId], references: [id])
  emailVerified   Boolean       @default(false)
  emailVerifiedAt DateTime?
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  sentMessages                  Message[]
  referrals                     Referral[]                  @relation("ReferentUserReferrals")
  favorites                     Favorite[]
  flagsReported                 Flag[]                      @relation("FlagReporter")
  flagsResolved                 Flag[]                      @relation("FlagResolver")
  notifications                 Notification[]
  handledLeads                  Lead[]                      @relation("LeadHandler")
  onboardingDraft               OnboardingDraft?
  sentOrganizationInvites       OrganizationInvite[]        @relation("OrganizationInviteSender")
  acceptedOrganizationInvites   OrganizationInvite[]        @relation("OrganizationInviteAcceptedUser")
  availabilitySmsChecks         AvailabilitySmsCheck[]
  bookedPhoneScreenings         PhoneScreeningAppointment[] @relation("PhoneScreeningBookedBy")
  aftercareProfileAssignments   AftercareProfileManagerAssignment[]
  reviewedAdminReviews          AdminReview[]               @relation("AdminReviewReviewer")
  submittedProfileClaimRequests ProfileClaimRequest[]       @relation("ProfileClaimRequester")
  reviewedProfileClaimRequests  ProfileClaimRequest[]       @relation("ProfileClaimReviewer")
  adminAuditLogs                AdminAuditLog[]             @relation("AdminAuditLogActor")
  providerImportBatches        ProviderImportBatch[]        @relation("ProviderImportBatchActor")
  sentProfileClaimOutreaches   ProfileClaimOutreach[]        @relation("ProfileClaimOutreachSender")
  smsOptInConsents             SmsOptInConsent[]

  @@index([orgId])
}

model SmsOptInConsent {
  id          String   @id @default(cuid())
  phone       String   @unique
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  consentText String
  consentedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([consentedAt])
}

model OnboardingDraft {
  id                  String    @id @default(cuid())
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  selectedAccountType String?
  activeStep          Int       @default(1)
  referentDraft       Json?
  soberLivingDraft    Json?
  continuedCareDraft  Json?
  completedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model Organization {
  id                       String              @id @default(cuid())
  type                     OrganizationType
  name                     String
  phone                    String?
  email                    String?
  website                  String?
  subscriptionPlan         String?
  subscriptionStatus       SubscriptionStatus?
  subscriptionBillingCycle String?
  stripeCustomerId         String?
  stripeSubscriptionId     String?
  subscriptionRenewsAt     DateTime?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  users                      User[]
  referentDetails            ReferentOrganization?
  profiles                   AftercareProfile[]
  leads                      Lead[]
  referentReferrals          Referral[]                  @relation("ReferentOrgReferrals")
  aftercareReferrals         Referral[]                  @relation("AftercareOrgReferrals")
  phoneScreeningAppointments PhoneScreeningAppointment[]
  favorites                  Favorite[]
  invites                    OrganizationInvite[]
  adminReviews               AdminReview[]

  @@index([type])
  @@index([subscriptionStatus])
}

model OrganizationInvite {
  id               String       @id @default(cuid())
  orgId            String
  organization     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email            String
  role             Role
  status           String       @default("pending")
  invitedByUserId  String?
  invitedByUser    User?        @relation("OrganizationInviteSender", fields: [invitedByUserId], references: [id])
  acceptedByUserId String?
  acceptedByUser   User?        @relation("OrganizationInviteAcceptedUser", fields: [acceptedByUserId], references: [id])
  acceptedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  aftercareManagerScope AftercareManagerScope @default(all_profiles)
  aftercareProfileAssignments OrganizationInviteProfileAssignment[]

  @@unique([orgId, email])
  @@index([email, status])
  @@index([orgId, status])
}

model ReferentOrganization {
  id                      String       @id @default(cuid())
  orgId                   String       @unique
  organization            Organization @relation(fields: [orgId], references: [id])
  orgTypeDetail           String
  streetAddress           String?
  city                    String?
  state                   String?
  zip                     String?
  healthSystemAffiliation String?
  medicalRecordsFax       String?
  npiNumber               String?
  stateLicenseNumber      String?
  ehrSystem               String?
  statesOperatedIn        String[]     @default([])
  roleOrganizationDescription String?
  levelsOfCare            String[]     @default([])
  currentPlacementMethods String[]     @default([])
  avgMonthlyReferrals     String?
  invitedTeamEmails       String[]     @default([])
  onboardingStep          Int          @default(1)
  onboardingCompletedAt   DateTime?
}

model AftercareProfile {
  id                             String                 @id @default(cuid())
  orgId                          String
  organization                   Organization           @relation(fields: [orgId], references: [id])
  type                           ProfileType
  programName                    String
  slug                           String                 @unique
  status                         ProfileStatus          @default(draft)
  unpublishedAt                  DateTime?
  unpublishedByUserId            String?
  verificationTier               Int                    @default(1)
  ownershipStatus                ProfileOwnershipStatus @default(claimed)
  claimedAt                      DateTime?
  claimedByUserId                String?
  seededByUserId                 String?
  importMatchKey                 String?                @unique
  lastClaimOutreachAt            DateTime?
  streetAddress                  String?
  city                           String
  state                          String
  zip                            String?
  publicCity                     String
  publicState                    String
  latitude                       Decimal?
  longitude                      Decimal?
  publicLatitude                 Decimal?
  publicLongitude                Decimal?
  geocodedAt                     DateTime?
  admissionsContactPhone         String?
  admissionsContactEmail         String?
  preferredContactMethod         String?
  intakeTurnaroundTime           String?
  websiteUrl                     String?
  programTypes                   String[]               @default([])
  telehealthAvailable            Boolean?
  telehealthMode                 String?
  additionalLocations            String?
  stateLicenseNumber             String?
  levelsOfCare                   String[]               @default([])
  hoursOfOperation               String?
  programmingSchedule            String[]               @default([])
  languagesServed                String[]               @default([])
  medicationServicesOffered      String[]               @default([])
  matServicesOffered             Boolean?
  coOccurringTreatment           Boolean?
  intakeContactName              String?
  clientAcceptanceMethods        String[]               @default([])
  referralProcessDescription     String?
  affiliatedSoberLivingHomes     String?
  populationServed               String?
  populationServedOptions        String[]               @default([])
  specialtyPopulations           String[]               @default([])
  recoveryResidenceLevel         String?
  certificationsHeld             String[]               @default([])
  accreditations                  String[]               @default([])
  clinicalFocus                   String[]               @default([])
  recoverySupportServices         String[]               @default([])
  totalBeds                      Int?
  bedsMen                        Int?
  bedsWomen                      Int?
  bedsLgbtq                      Int?
  bedsMenAvailable               Int?
  bedsWomenAvailable             Int?
  bedsLgbtqAvailable             Int?
  roomTypes                      String[]               @default([])
  bedTypes                       String[]               @default([])
  bedsReservedNotes              String?
  wheelchairAccessibleBeds       Int?
  averageLengthOfStay            String?
  bedsAvailable                  Int?
  bedsAvailableUpdatedAt         DateTime?
  acceptingNewPatients           Boolean?
  acceptingNewPatientsUpdatedAt  DateTime?
  nextAvailableDate              DateTime?
  availabilityNotes              String?
  pricePerWeek                   Int?
  moveInCost                     String?
  fundingAvailable               Boolean?
  fundingNotes                   String?
  insuranceAccepted              String[]               @default([])
  supportServices                String[]               @default([])
  amenities                      String[]               @default([])
  medicationAdministration       String?
  matAccepted                    String[]               @default([])
  medicationRestrictions         String?
  drugTestingPolicy              String?
  description                    String?
  houseRulesUrl                  String?
  houseRulesText                 String?
  photoReadiness                 String[]               @default([])
  videoUrls                      String[]               @default([])
  goodNeighborPolicyAcknowledged Boolean                @default(false)
  referralFitNotes               String?
  onboardingStep                 Int                    @default(1)
  onboardingCompletedAt          DateTime?
  publishedAt                    DateTime?
  createdAt                      DateTime               @default(now())
  updatedAt                      DateTime               @updatedAt

  certifications             VerificationDocument[]
  images                     ProfileImage[]
  referrals                  Referral[]
  leads                      Lead[]
  flags                      Flag[]
  favorites                  Favorite[]
  availabilitySmsChecks      AvailabilitySmsCheck[]
  phoneScreeningWindows      PhoneScreeningWindow[]
  phoneScreeningAppointments PhoneScreeningAppointment[]
  adminReviews               AdminReview[]
  claimRequests              ProfileClaimRequest[]
  claimOutreaches            ProfileClaimOutreach[]
  managerAssignments         AftercareProfileManagerAssignment[]
  inviteAssignments          OrganizationInviteProfileAssignment[]
  continuedCareAssociations  ProfileAssociation[]        @relation("SoberLivingAssociations")
  soberLivingAssociations    ProfileAssociation[]        @relation("ContinuedCareAssociations")

  @@index([orgId])
  @@index([type, status])
  @@index([publicCity, publicState])
  @@index([verificationTier])
  @@index([ownershipStatus])
}

model ProviderImportBatch {
  id                       String              @id @default(cuid())
  actorUserId              String?
  actorUser                User?               @relation("ProviderImportBatchActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  sourceFileName           String
  status                   String              @default("validated")
  totalRows                Int                 @default(0)
  newOrganizationCount     Int                 @default(0)
  newLocationCount         Int                 @default(0)
  matchedLocationCount     Int                 @default(0)
  rejectedRowCount         Int                 @default(0)
  committedAt              DateTime?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  rows                     ProviderImportRow[]

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([status, createdAt])
}

model ProviderImportRow {
  id                 String              @id @default(cuid())
  importBatchId      String
  importBatch        ProviderImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  rowNumber          Int
  rawData            Json
  normalizedData     Json?
  previewAction      String
  status             String              @default("validated")
  errorReasons       String[]            @default([])
  organizationId     String?
  profileId          String?
  resultMessage      String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@unique([importBatchId, rowNumber])
  @@index([importBatchId, status])
  @@index([profileId])
}

model AftercareProfileManagerAssignment {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileId String
  profile   AftercareProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([userId, profileId])
  @@index([profileId])
}

model OrganizationInviteProfileAssignment {
  id        String             @id @default(cuid())
  inviteId  String
  invite    OrganizationInvite @relation(fields: [inviteId], references: [id], onDelete: Cascade)
  profileId String
  profile   AftercareProfile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now())

  @@unique([inviteId, profileId])
  @@index([profileId])
}

model ProfileAssociation {
  id                     String   @id @default(cuid())
  soberLivingProfileId   String
  continuedCareProfileId String
  createdAt              DateTime @default(now())

  soberLivingProfile   AftercareProfile @relation("SoberLivingAssociations", fields: [soberLivingProfileId], references: [id], onDelete: Cascade)
  continuedCareProfile AftercareProfile @relation("ContinuedCareAssociations", fields: [continuedCareProfileId], references: [id], onDelete: Cascade)

  @@unique([soberLivingProfileId, continuedCareProfileId])
  @@index([continuedCareProfileId])
}

model ProfileClaimRequest {
  id                    String             @id @default(cuid())
  profileId             String
  profile               AftercareProfile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  claimantUserId        String?
  claimantUser          User?              @relation("ProfileClaimRequester", fields: [claimantUserId], references: [id], onDelete: SetNull)
  claimantName          String
  claimantEmail         String
  claimantPhone         String?
  claimantRole          String?
  claimantOrganization  String?
  relationshipToProgram String?
  notes                 String?
  status                ProfileClaimStatus @default(pending)
  reviewedByUserId      String?
  reviewedByUser        User?              @relation("ProfileClaimReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewerNotes         String?
  submittedAt           DateTime           @default(now())
  reviewedAt            DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([profileId, status])
  @@index([claimantUserId])
  @@index([claimantEmail])
  @@index([status, submittedAt])
}

model ProfileClaimOutreach {
  id                 String           @id @default(cuid())
  profileId          String
  profile            AftercareProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  sentByUserId       String?
  sentByUser         User?            @relation("ProfileClaimOutreachSender", fields: [sentByUserId], references: [id], onDelete: SetNull)
  recipientEmail     String
  recipientName      String?
  tokenHash          String           @unique
  status             String           @default("pending")
  provider           String?
  providerMessageId  String?          @unique
  errorMessage       String?
  expiresAt          DateTime
  sentAt             DateTime?
  deliveredAt        DateTime?
  clickedAt          DateTime?
  claimStartedAt     DateTime?
  claimCompletedAt   DateTime?
  claimRequestId     String?
  unsubscribedAt     DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([profileId, createdAt])
  @@index([recipientEmail, createdAt])
  @@index([status, createdAt])
}

model EmailSuppression {
  id                String   @id @default(cuid())
  email             String   @unique
  reason            String   @default("unsubscribe")
  sourceOutreachId  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([createdAt])
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actorUser   User?    @relation("AdminAuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
}

model ProfileImage {
  id          String           @id @default(cuid())
  profileId   String
  profile     AftercareProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  url         String
  storagePath String
  altText     String?
  sortOrder   Int              @default(0)
  isCover     Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([profileId, sortOrder])
  @@index([profileId, isCover])
}

model Favorite {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId     String
  org       Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  profileId String
  profile   AftercareProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  @@unique([orgId, profileId])
  @@index([userId])
  @@index([orgId, createdAt])
  @@index([profileId])
}

model AvailabilitySmsCheck {
  id           String           @id @default(cuid())
  token        String           @unique
  orgId        String
  profileId    String
  profile      AftercareProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone        String
  status       String           @default("pending")
  outboundBody String
  inboundBody  String?
  errorMessage String?
  sentAt       DateTime?
  respondedAt  DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([phone, status, createdAt])
  @@index([profileId, status])
  @@index([orgId, status])
}

model VerificationDocument {
  id           String           @id @default(cuid())
  profileId    String
  profile      AftercareProfile @relation(fields: [profileId], references: [id])
  documentType String
  url          String
  expiresAt    DateTime?
  status       DocumentStatus   @default(pending)
  submittedAt  DateTime         @default(now())
  reviewedAt   DateTime?
  notes        String?

  @@index([profileId])
  @@index([status])
  @@index([expiresAt])
}

model AdminReview {
  id               String                 @id @default(cuid())
  subjectType      AdminReviewSubjectType
  status           AdminReviewStatus      @default(pending)
  orgId            String
  organization     Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  profileId        String?
  profile          AftercareProfile?      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  submittedByEmail String?
  reviewerNotes    String?
  reviewedByUserId String?
  reviewedByUser   User?                  @relation("AdminReviewReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  submittedAt      DateTime               @default(now())
  reviewedAt       DateTime?
  updatedAt        DateTime               @updatedAt

  @@index([status, submittedAt])
  @@index([subjectType, status])
  @@index([orgId])
  @@index([profileId])
}

model Referral {
  id                       String           @id @default(cuid())
  referentUserId           String
  referentUser             User             @relation("ReferentUserReferrals", fields: [referentUserId], references: [id])
  referentOrgId            String
  referentOrg              Organization     @relation("ReferentOrgReferrals", fields: [referentOrgId], references: [id])
  aftercareOrgId           String
  aftercareOrg             Organization     @relation("AftercareOrgReferrals", fields: [aftercareOrgId], references: [id])
  aftercareProfileId       String
  aftercareProfile         AftercareProfile @relation(fields: [aftercareProfileId], references: [id])
  caseManagerName          String
  caseManagerEmail         String
  caseManagerPhone         String
  caseManagerOrganization  String
  clientAgeRange           String
  supportCategory          String
  insuranceCategory        String
  preferredStartWindow     String
  specialNeeds             String[]         @default([])
  reasonForReferral        String
  status                   ReferralStatus   @default(pending)
  statusUpdatedAt          DateTime         @default(now())
  waitlistPosition         Int?
  expectedAvailabilityDate DateTime?
  declineReason            String?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  messages                   Message[]
  phoneScreeningAppointments PhoneScreeningAppointment[]

  @@index([referentOrgId, status])
  @@index([aftercareOrgId, status])
  @@index([aftercareProfileId, status])
  @@index([createdAt])
}

model PhoneScreeningWindow {
  id          String           @id @default(cuid())
  profileId   String
  profile     AftercareProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  dayOfWeek   Int
  startMinute Int
  endMinute   Int
  slotMinutes Int              @default(30)
  timezone    String           @default("America/New_York")
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([profileId, isActive])
  @@index([dayOfWeek])
}

model PhoneScreeningAppointment {
  id                 String           @id @default(cuid())
  referralId         String
  referral           Referral         @relation(fields: [referralId], references: [id], onDelete: Cascade)
  aftercareProfileId String
  aftercareProfile   AftercareProfile @relation(fields: [aftercareProfileId], references: [id], onDelete: Cascade)
  aftercareOrgId     String
  aftercareOrg       Organization     @relation(fields: [aftercareOrgId], references: [id], onDelete: Cascade)
  bookedByUserId     String
  bookedByUser       User             @relation("PhoneScreeningBookedBy", fields: [bookedByUserId], references: [id], onDelete: Cascade)
  startsAt           DateTime
  endsAt             DateTime
  timezone           String           @default("America/New_York")
  status             String           @default("scheduled")
  cancellationReason String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([referralId, status])
  @@index([aftercareProfileId, startsAt])
  @@index([aftercareOrgId, startsAt])
  @@index([bookedByUserId, startsAt])
  @@index([status, startsAt])
}

model Message {
  id           String    @id @default(cuid())
  referralId   String
  referral     Referral  @relation(fields: [referralId], references: [id])
  senderUserId String
  senderUser   User      @relation(fields: [senderUserId], references: [id])
  senderRole   Role
  body         String
  readAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([referralId, createdAt])
  @@index([senderUserId])
}

model Lead {
  id              String           @id @default(cuid())
  profileId       String
  profile         AftercareProfile @relation(fields: [profileId], references: [id])
  aftercareOrgId  String
  aftercareOrg    Organization     @relation(fields: [aftercareOrgId], references: [id])
  name            String
  email           String
  phone           String?
  message         String
  source          String           @default("public_profile_contact")
  status          LeadStatus       @default(new)
  handledByUserId String?
  handledByUser   User?            @relation("LeadHandler", fields: [handledByUserId], references: [id])
  handledAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([profileId])
  @@index([aftercareOrgId, status])
  @@index([createdAt])
}

model Flag {
  id               String           @id @default(cuid())
  profileId        String
  profile          AftercareProfile @relation(fields: [profileId], references: [id])
  reportedByUserId String?
  reportedByUser   User?            @relation("FlagReporter", fields: [reportedByUserId], references: [id])
  flagType         String
  description      String
  status           FlagStatus       @default(open)
  resolvedByUserId String?
  resolvedByUser   User?            @relation("FlagResolver", fields: [resolvedByUserId], references: [id])
  resolvedAt       DateTime?
  createdAt        DateTime         @default(now())

  @@index([profileId])
  @@index([status])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  type      String
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([createdAt])
}
